--- !u!114 &5418477384212578649
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6296041061318250216}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b957306d0e3235e4f88bd9b0bae2dfcd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  theme: {fileID: 11400000, guid: 65b45ff899bad924cb3622bcaed7204a, type: 2}
  pages:
  - Title: "\uAC8C\uC784\uC758 \uBAA9\uD45C"
    Description: "\uC0C1\uB300\uC758 \uC2DC\uAC04\uC744 00:00\uC73C\uB85C \uB9CC\uB4E4\uBA74
      \uC2B9\uB9AC\uD569\uB2C8\uB2E4. \uC9D5\uC218\uB85C Bank\uB97C \uCC44\uC6B0\uACE0,
      \uBC30\uAE09\uC73C\uB85C \uC218\uBA85\uC744 \uD655\uBCF4\uD558\uC138\uC694."
    Screenshot: {fileID: 0}
    Callouts:
    - Visible: 0
      HighlightPosition: {x: 0.5, y: 0.5}
      PanelPosition: {x: 0.5, y: 0.5}
      Title: "\uB0B4 \uC218\uBA85"
      Description: "00:00\uC774 \uB418\uBA74\n\uD328\uBC30\uD569\uB2C8\uB2E4."
    - Visible: 0
      HighlightPosition: {x: 0.5, y: 0.5}
      PanelPosition: {x: 0.5, y: 0.5}
      Title: "\uC0C1\uB300 \uC218\uBA85"
      Description: "00:00\uC73C\uB85C \uB9CC\uB4E4\uBA74\n\uC2B9\uB9AC\uD569\uB2C8\uB2E4."
    - Visible: 0
      HighlightPosition: {x: 0.5, y: 0.5}
      PanelPosition: {x: 0.5, y: 0.5}
      Title: Time Bank
      Description: "\uC9D5\uC218\uB85C \uBAA8\uC73C\uACE0\n\uBC30\uAE09\uC73C\uB85C
        \uAEBC\uB0C5\uB2C8\uB2E4."
  - Title: "\uD68C\uC911\uC2DC\uACC4 \uC120\uD0DD"
    Description: "\uACF5\uAC1C\uB41C \uC2DC\uACC4\uC758 \uC22B\uC790\uC640 \uC885\uB958\uB97C
      \uAE30\uC5B5\uD558\uC138\uC694. \uB2EB\uD78C \uC2DC\uACC4\uB97C \uACE0\uB978
      \uB4A4 \uC9D5\uC218 \uB610\uB294 \uBC30\uAE09\uC744 \uACB0\uC815\uD569\uB2C8\uB2E4."
    Screenshot: {fileID: 0}
    Callouts:
    - Visible: 0
      HighlightPosition: {x: 0.5, y: 0.5}
      PanelPosition: {x: 0.5, y: 0.5}
      Title: "\uD68C\uC911\uC2DC\uACC4"
      Description: "\uC22B\uC790\uC640 \uC885\uB958\uB97C\n\uAE30\uC5B5\uD558\uC138\uC694."
    - Visible: 0
      HighlightPosition: {x: 0.5, y: 0.5}
      PanelPosition: {x: 0.5, y: 0.5}
      Title: "\uC2DC\uACC4 \uC120\uD0DD"
      Description: "\uB2EB\uD78C \uC2DC\uACC4 \uD558\uB098\uB97C\n\uBA3C\uC800 \uD074\uB9AD\uD558\uC138\uC694."
    - Visible: 0
      HighlightPosition: {x: 0.5, y: 0.5}
      PanelPosition: {x: 0.5, y: 0.5}
      Title: "\uC120\uD0DD \uC815\uBCF4"
      Description: "\uD589\uB3D9 \uD655\uC815 \uC804\uAE4C\uC9C0\n\uB0B4\uC6A9\uC740
        \uC228\uACA8\uC9D1\uB2C8\uB2E4."
  - Title: "\uC9D5\uC218\uC640 \uBC30\uAE09"
    Description: "\uC77C\uBC18\xB7\uBE68\uAC04 \uC2DC\uACC4\uC5D0 \uB530\uB77C \uC2DC\uAC04\uC774
      \uC774\uB3D9\uD558\uB294 \uB300\uC0C1\uC774 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.
      \uBC30\uAE09\uB7C9\uC740 \uC2DC\uACC4 \uC2DC\uAC04\uC758 1/3\uC774\uBA70 Bank
      \uC794\uC561\uC744 \uB118\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    Screenshot: {fileID: 0}
    Callouts:
    - Visible: 0
      HighlightPosition: {x: 0.5, y: 0.5}
      PanelPosition: {x: 0.5, y: 0.5}
      Title: "\uC9D5\uC218"
      Description: "\uC77C\uBC18\uC740 \uC0C1\uB300, \uBE68\uAC15\uC740\n\uB0B4 \uC218\uBA85\uC5D0\uC11C
        \uC62E\uAE41\uB2C8\uB2E4."
    - Visible: 0
      HighlightPosition: {x: 0.5, y: 0.5}
      PanelPosition: {x: 0.5, y: 0.5}
      Title: "\uBC30\uAE09"
      Description: "\uC77C\uBC18\uC740 \uB098, \uBE68\uAC15\uC740\n\uC0C1\uB300\uC5D0\uAC8C
        \uC9C0\uAE09\uD569\uB2C8\uB2E4."
    - Visible: 0
      HighlightPosition: {x: 0.5, y: 0.5}
      PanelPosition: {x: 0.5, y: 0.5}
      Title: "\uC815\uC0B0"
      Description: "\uB0A8\uC740 \uC218\uBA85\xB7Bank \uD55C\uB3C4\n\uC548\uC5D0\uC11C\uB9CC
        \uC774\uB3D9\uD569\uB2C8\uB2E4."
  - Title: "\uC544\uC774\uD15C"
    Description: "\uC544\uC774\uD15C\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB824
      \uC124\uBA85\uC744 \uC77D\uACE0, \uD074\uB9AD\uD574 \uC120\uD0DD\uD55C \uB4A4
